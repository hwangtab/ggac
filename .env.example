# =============================================================================
# Supabase (단계 4 Task 5 이후: 앱은 더 이상 Supabase에 접속하지 않는다)
# =============================================================================
# 앱 코드에 Supabase 클라이언트가 0개다(정적 가드가 강제). 아래 값들이 여전히
# 필요한 이유는 서로 다르니 구분할 것.
#
# NEXT_PUBLIC_SUPABASE_URL — **더 이상 필요 없다.**
#   저장된 URL을 Blob으로 재작성하는 컷오버가 끝난 뒤 운영 DB를 실측해 남은
#   Supabase Storage 절대 URL이 0건임을 확인했고, 2026-09-01에 Supabase
#   프로젝트(btugywkltavbogdnhwpu) 자체가 삭제됐다. 이 값을 읽던 판정 4곳
#   (safeUrl.ts·storageUrlValidation.ts·imageDimensions.ts·storage/paths.ts)과
#   CSP/preconnect를 모두 걷어냈다. Vercel에서 지워도 아무것도 깨지지 않는다.

# NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   앱 코드에서는 더 이상 쓰지 않는다. 이관·컷오버 스크립트(scripts/migrate,
#   scripts/storage)가 Supabase에서 데이터를 읽을 때만 필요하므로, 그 작업이
#   끝나면 제거할 수 있다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# Site Configuration
# =============================================================================
# 사이트의 공개 URL (sitemap, robots.txt, OG 이미지 등에 사용)
NEXT_PUBLIC_SITE_URL=https://ggac.kr

# 빌드 버전 (에러 추적용, 선택사항)
NEXT_PUBLIC_BUILD_VERSION=1.0.0

# =============================================================================
# Session & Activity Tracking
# =============================================================================
# 세션 활동 체크 간격 (밀리초, 기본값: 90000ms = 90초)
NEXT_PUBLIC_SESSION_PING_MS=90000

# =============================================================================
# Image Optimization
# =============================================================================
# 허용되는 이미지 품질 레벨 (쉼표로 구분, 선택사항)
# 예: "75,80,85,90,95,100"
NEXT_PUBLIC_IMAGE_ALLOWED_QUALITIES=75,80,85,90,95,100

# =============================================================================
# Content Security Policy (CSP)
# =============================================================================
# 개발 환경에서 엄격한 CSP 정책 활성화 (선택사항)
# production에서는 항상 엄격한 CSP가 적용됨
NEXT_STRICT_CSP=false

# =============================================================================
# Deployment & Webhooks
# =============================================================================
# Deploy Hook Secret (웹훅 보안용, 선택사항)
# /api/webhook/deploy-hook 엔드포인트 보호
DEPLOY_HOOK_SECRET=your-secret-here

# Vercel Deploy Hook URL (자동 배포 트리거용)
# Vercel 프로젝트 설정에서 생성한 Deploy Hook URL
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your-hook-url

# =============================================================================
# Rate Limiting (Required for distributed/serverless environments)
# =============================================================================
# Upstash Redis 자격 증명. Vercel 등 서버리스/분산 환경에서는 반드시 설정해야 합니다.
# 설정하지 않으면 인스턴스마다 별도의 메모리 카운터를 갖게 되어 rate limiting이
# 사실상 무효화됩니다 (운영 환경에서는 시작 시 경고 로그가 반복적으로 출력됩니다).
# https://console.upstash.com/redis 에서 생성
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here
# Vercel Marketplace Upstash Redis는 아래 KV_* 이름으로 자동 주입될 수 있습니다.
# KV_REST_API_URL=https://your-redis.upstash.io
# KV_REST_API_TOKEN=your-token-here

# =============================================================================
# Node Environment
# =============================================================================
# Next.js가 자동으로 설정 (development / production / test)
# NODE_ENV=development

# Turso (단계 0에서 도입)
# 비워두면(또는 file:local.db로 두면) 로컬 SQLite 파일을 사용한다.
# 운영 DB(ggac-prod)에 연결하려면 libsql://... URL과 토큰을 지정한다.
# 발급: turso db show ggac-prod --url / turso db tokens create ggac-prod
# 운영 절차는 scripts/turso/README.md 참고.
#
# ⚠️ 주의: `vercel env pull`과 `vercel blob create-store`는 .env.local을
# Vercel 원격 환경변수 저장소 기준으로 통째로 덮어쓴다. 원격에 없는 로컬 전용
# 값(TURSO_AUTH_TOKEN 등)은 그 과정에서 조용히 삭제된다 — Task 9에서 실제로
# TURSO_AUTH_TOKEN이 이렇게 사라져 재발급해야 했다. 이 명령들을 실행하기 전에
# .env.local의 로컬 전용 값을 반드시 백업해 둘 것.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Better Auth (단계 0에서 도입, 단계 2에서 활성화)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob (단계 0에서 도입, 단계 1에서 활성화)
PUBLIC_BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=
# NEXT_PUBLIC_ 접두사 필수 — 'use client' 컴포넌트의 렌더 게이트가 브라우저에서
# 이 값을 읽는다(최종 리뷰 Finding 1). 접두사 없는 이름은 클라이언트 번들에
# 인라인되지 않아 항상 false로 판정된다.
NEXT_PUBLIC_BLOB_PUBLIC_BASE_URL=

# STORAGE_PROVIDER는 단계 4 Task 5에서 사라졌다. 코드에 제공자 분기가 없고
# 저장소는 Vercel Blob 하나뿐이다 — 설정해도 아무 효과가 없다.
