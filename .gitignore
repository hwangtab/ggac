# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# backups and local data (do not commit)
backups/

# internal documentation — governance/meeting records, sensitive content
docs/

# playwright MCP session logs — may contain PII/sensitive test data
.playwright-mcp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
!.env.example

# vercel
.vercel

# domain & SSL
ssl/
certificates/

# typescript
*.tsbuildinfo
next-env.d.ts

# test files
test-*.js
test-github-mcp.js
test-slack-mcp.js
