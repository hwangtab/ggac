# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# backups and local data (do not commit)
backups/

# internal documentation — governance/meeting records, sensitive content
# `docs/`가 아니라 `docs/*`인 이유: 디렉터리를 통째로 제외하면 git이 그 안을
# 들여다보지 않아 하위 예외(!)가 전혀 먹지 않는다.
docs/*
# 예외: 공개해도 되는 제도·절차 매뉴얼만 추적한다. 조합 내부 현황·판단이
# 담긴 문서는 여기 두지 말고 이사회 서류함(비공개 Blob)에 올린다.
!docs/사회적기업/

# playwright MCP session logs — may contain PII/sensitive test data
.playwright-mcp/

# local Codex agent configuration
.codex/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
!.env.example

# vercel
.vercel

# domain & SSL
ssl/
certificates/

# typescript
*.tsbuildinfo
next-env.d.ts

# test files
test-*.js
test-github-mcp.js
test-slack-mcp.js
.env*.local

# Playwright test artifacts
test-results/

# Turso 로컬 개발 DB (drizzle-kit push가 생성)
local.db

# 격리 워크트리 (superpowers:using-git-worktrees)
.worktrees/

# RLS 토글 스크립트의 로컬 산출물 (rls-toggle.mjs가 생성)
scripts/testing/.rls-state.json

# 이관 스크립트 단위 테스트가 만드는 로컬 libSQL 파일 DB(테스트가 중간에
# 죽으면 정리 없이 .db/-wal/-shm이 남을 수 있다)
# (이름을 하나씩 나열하다가 이미 몇 개가 빠져 있었다 — 규칙으로 바꾼다.
# 테스트가 만드는 파일 DB는 전부 `scripts/testing/.<이름>.db` 형태다.)
scripts/testing/.*.db
scripts/testing/.*.db-*

# 권한 경계 E2E 픽스처 산출물 (seed-authz-fixtures.mjs가 생성, 로컬 전용 UUID)
e2e/.authz-fixtures.json

# 권한 경계 E2E 로그인 세션 (authz.setup.ts가 storageState로 저장, 실제 쿠키 포함)
e2e/.auth/

# 운영 DB 덤프·백업이 저장소 루트로 떨어지는 사고 방지.
# `turso db shell ggac-prod .dump > backup.sql`을 저장소 루트에서 실행하면
# 조합원 전원의 계좌번호·생년월일·비밀번호 해시가 CWD에 떨어지고,
# `git add -A` 한 번이면 그대로 공개 저장소에 올라간다. 덤프는 저장소
# 밖(`mktemp -d`)에서만 다루는 것이 규칙이지만(scripts/turso/README.md),
# 규칙을 어겼을 때 막아주는 그물이 하나도 없었다.
#
# **루트 한정(`/`) 규칙이다.** `src/db/migrations/*.sql`,
# `supabase/migrations/*.sql`, `scripts/database/**/*.sql`처럼 정당하게
# 커밋되는 SQL은 전부 하위 디렉터리에 있어 걸리지 않는다.
/*.sql
/*.sql.gz
/*.dump
/*.db
/*.db-shm
/*.db-wal

# serena(에디터 심볼 캐시) — 재생성 가능한 바이너리이고, 소스 본문을 통째로
# 담고 있어 하드코딩된 값이 있으면 그대로 함께 커밋된다(실제로 옛 Supabase
# anon 키가 이 캐시에 남아 있었다).
.serena/cache/
