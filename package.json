{
  "name": "gac-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run images:optimize && npm run images:verify && npm run llms:generate && next build",
    "start": "next start",
    "lint": "eslint src e2e --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src e2e --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:e2e": "rm -rf .next node_modules/.cache/webpack && env -u NO_COLOR playwright test",
    "test:e2e:ui": "rm -rf .next node_modules/.cache/webpack && env -u NO_COLOR playwright test --ui",
    "test:runtime-risks": "node scripts/testing/assert-runtime-risks.mjs",
    "test:unit": "node --test scripts/testing/*.test.mjs",
    "schema:snapshot": "node scripts/testing/refresh-schema-snapshot.mjs",
    "test:schema-contract": "node scripts/testing/check-schema-contract.mjs",
    "audit:security": "npm audit --audit-level high",
    "env:check": "node scripts/verify-env.js",
    "env:check:production": "NODE_ENV=production node scripts/verify-env.js",
    "env:check:vercel:production": "NODE_ENV=production node scripts/verify-env.js --source=vercel",
    "images:optimize": "node scripts/utils/image-processing/ensure-webp.js && node scripts/utils/image-processing/update-image-references.js",
    "images:verify": "node scripts/utils/image-processing/update-image-references.js --check && node scripts/utils/image-processing/verify-webp.js",
    "storage:ensure-webp": "node scripts/utils/storage/ensure-supabase-webp.js",
    "llms:generate": "node scripts/utils/content/generate-llms-txt.mjs",
    "new:show": "node scripts/utils/content/new-show.mjs",
    "llms:check": "node scripts/utils/content/generate-llms-txt.mjs --check",
    "prepare": "husky",
    "vercel:build": "npm run images:optimize && npm run images:verify && npm run llms:generate && next build",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel --prod",
    "vercel:preview": "vercel",
    "deploy": "curl -X POST https://ggac.kr/api/webhook/deploy-hook",
    "deploy:notify": "node scripts/utils/deployment/deploy-notify.js",
    "deploy:smoke": "node scripts/utils/deployment/smoke-check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.108.2",
    "cheerio": "1.0.0-rc.12",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.536.0",
    "next": "^15.5.19",
    "next-intl": "^4.12.0",
    "pretendard": "^1.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^9.0.0",
    "react-quill-new": "^3.6.0",
    "sanitize-html": "^2.17.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.3",
    "@commitlint/config-conventional": "^19.0.3",
    "@next/bundle-analyzer": "^15.3.5",
    "@playwright/test": "^1.53.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-image-crop": "^8.1.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/webgl2": "^0.0.11",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "audit-ci": "^7.0.1",
    "autoprefixer": "^10.0.1",
    "critters": "^0.0.23",
    "eslint": "^8",
    "eslint-config-next": "^15.5.19",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.15",
    "prettier": "^3.4.1",
    "puppeteer": "^24.15.0",
    "sharp": "^0.34.2",
    "supabase": "^2.40.7",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "react-quill": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "quill": "2.0.2",
    "postcss": "$postcss"
  },
  "browserslist": {
    "production": [
      "Chrome >= 110",
      "Firefox >= 115",
      "Safari >= 16",
      "Edge >= 110",
      "iOS >= 16",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.13"
  }
}
