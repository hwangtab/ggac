{
  "name": "gac-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run images:optimize && npm run images:verify && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:security": "npm audit --audit-level high",
    "images:optimize": "node scripts/utils/image-processing/ensure-webp.js && node scripts/utils/image-processing/update-image-references.js",
    "images:verify": "node scripts/utils/image-processing/update-image-references.js --check && node scripts/utils/image-processing/verify-webp.js",
    "storage:ensure-webp": "node scripts/utils/storage/ensure-supabase-webp.js",
    "prepare": "husky",
    "vercel:build": "npm run images:optimize && npm run images:verify && next build",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel --prod",
    "vercel:preview": "vercel",
    "deploy": "curl -X POST https://ggac.kr/api/webhook/deploy-hook",
    "deploy:notify": "node scripts/deploy-notify.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.57.0",
    "cheerio": "1.0.0-rc.12",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "lucide-react": "^0.536.0",
    "next": "^15.5.15",
    "next-intl": "^4.12.0",
    "pretendard": "^1.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^9.0.0",
    "react-quill-new": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.3",
    "@commitlint/config-conventional": "^19.0.3",
    "@next/bundle-analyzer": "^15.3.5",
    "@playwright/test": "^1.53.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-image-crop": "^8.1.6",
    "@types/webgl2": "^0.0.11",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "audit-ci": "^7.0.1",
    "autoprefixer": "^10.0.1",
    "critters": "^0.0.23",
    "eslint": "^8",
    "eslint-config-next": "^15.5.15",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "postcss": "^8",
    "prettier": "^3.4.1",
    "puppeteer": "^24.15.0",
    "sharp": "^0.34.2",
    "supabase": "^2.40.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  },
  "overrides": {
    "react-quill": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "quill": "2.0.2"
  },
  "browserslist": {
    "production": [
      "Chrome >= 110",
      "Firefox >= 115",
      "Safari >= 16",
      "Edge >= 110",
      "iOS >= 16",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
