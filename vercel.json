{
  "framework": "nextjs",
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/_next/static/css/(.*\\.css)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/_next/static/js/(.*\\.js)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/images/(.*\\.webp)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/webp"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/images/(.*\\.avif)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/avif"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/images/(.*\\.jpg|.*\\.jpeg)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/images/(.*\\.png)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/images/(.*\\.svg)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/images/artists/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/images(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*\\.woff2)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/woff2"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*\\.woff)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/woff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*\\.ttf)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/ttf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    {
      "src": "/api/posts/([^/]+)/likes",
      "dest": "/api/posts/[id]/likes"
    },
    {
      "src": "/api/posts/([^/]+)/attachments/([^/]+)",
      "dest": "/api/posts/[id]/attachments/[attachmentId]"
    },
    {
      "src": "/api/posts/([^/]+)/attachments",
      "dest": "/api/posts/[id]/attachments"
    },
    {
      "src": "/api/posts/([^/]+)/view",
      "dest": "/api/posts/[id]/view"
    },
    {
      "src": "/api/posts/([^/]+)",
      "dest": "/api/posts/[id]"
    },
    {
      "src": "/api/comments/([^/]+)/like",
      "dest": "/api/comments/[id]/like"
    },
    {
      "src": "/api/admin/members/([^/]+)",
      "dest": "/api/admin/members/[id]"
    },
    {
      "src": "/api/admin/posts/([^/]+)",
      "dest": "/api/admin/posts/[id]"
    },
    {
      "src": "/api/admin/artists/([^/]+)/members/([^/]+)",
      "dest": "/api/admin/artists/[id]/members/[memberId]"
    },
    {
      "src": "/api/admin/artists/([^/]+)/members",
      "dest": "/api/admin/artists/[id]/members"
    },
    {
      "src": "/api/admin/artists/([^/]+)",
      "dest": "/api/admin/artists/[id]"
    },
    {
      "src": "/api/notifications/([^/]+)",
      "dest": "/api/notifications/[id]"
    },
    {
      "src": "/api/users/([^/]+)/likes",
      "dest": "/api/users/[id]/likes"
    },
    {
      "src": "/api/test-patch/([^/]+)",
      "dest": "/api/test-patch/[id]"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ggac.kr"
        }
      ],
      "destination": "https://ggac.kr/$1",
      "permanent": true
    }
  ]
}